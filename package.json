{
  "name": "subtitle-sync",
  "version": "0.1.0",
  "description": "Lightweight manual subtitle playback controller built with Electron.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node electron/smoke-check.js",
    "pack": "electron-builder --dir --win",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "koffi": "^3.1.5"
  },
  "build": {
    "appId": "com.subtitlesync.app",
    "productName": "SubtitleSync",
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "icon.ico",
          "icon.png"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SubtitleSync",
      "installerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}
